diff -ruN orig/crates/deckle-core/src/proc.rs deckle-0.7.0/crates/deckle-core/src/proc.rs
--- orig/crates/deckle-core/src/proc.rs	1970-01-01 00:00:00.000000000 +0000
+++ deckle-0.7.0/crates/deckle-core/src/proc.rs	2026-10-28 00:37:49.876759987 +0000
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Child processes without a console window.
+//!
+//! Deckle's desktop app is a windowless GUI program. On Windows, when such a program starts a
+//! console program (`powershell`, `schtasks`, Kindle Previewer's command line) the system opens
+//! a new console window for it unless `CREATE_NO_WINDOW` is passed. Call [`NoWindow::no_window`]
+//! on every `Command` before running it. It does nothing on macOS and Linux.
+
+use std::process::Command;
+
+pub trait NoWindow {
+    /// Keeps the child from opening a console window (Windows only).
+    fn no_window(&mut self) -> &mut Self;
+}
+
+impl NoWindow for Command {
+    #[cfg(windows)]
+    fn no_window(&mut self) -> &mut Self {
+        use std::os::windows::process::CommandExt;
+        const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+        self.creation_flags(CREATE_NO_WINDOW)
+    }
+
+    #[cfg(not(windows))]
+    fn no_window(&mut self) -> &mut Self {
+        self
+    }
+}
