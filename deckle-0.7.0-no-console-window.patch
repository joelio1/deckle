diff -ruN orig/.github/workflows/windows-build.yml deckle-0.7.0/.github/workflows/windows-build.yml
--- orig/.github/workflows/windows-build.yml	1970-01-01 00:00:00.000000000 +0000
+++ deckle-0.7.0/.github/workflows/windows-build.yml	2026-10-28 00:39:28.493574282 +0000
@@ -0,0 +1,56 @@
+name: windows-build
+# Windows-only, unsigned build of the installer. Run it by hand: Actions tab -> windows-build -> Run workflow.
+# The installer is kept as a workflow artifact for 14 days; no release is created.
+on:
+  workflow_dispatch:
+
+jobs:
+  windows:
+    runs-on: windows-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: dtolnay/rust-toolchain@stable
+        with:
+          targets: x86_64-pc-windows-msvc
+      - uses: Swatinem/rust-cache@v2
+        with:
+          key: x86_64-pc-windows-msvc
+      - uses: pnpm/action-setup@v4
+        with:
+          version: 12.5.1
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: pnpm
+          cache-dependency-path: apps/desktop/pnpm-lock.yaml
+      - run: pnpm install --frozen-lockfile
+        working-directory: apps/desktop
+      - name: Updater signing key present
+        shell: bash
+        env:
+          TAURI_SIGNING_PRIVATE_KEY: ${{ secrets.TAURI_SIGNING_PRIVATE_KEY }}
+        run: |
+          if [ -z "$TAURI_SIGNING_PRIVATE_KEY" ]; then
+            echo "::error::Add the TAURI_SIGNING_PRIVATE_KEY repository secret (see the instructions)."
+            exit 1
+          fi
+      - name: PDFium
+        shell: bash
+        run: |
+          set -euo pipefail
+          tools/fetch-pdfium.sh win-x64
+          mkdir -p apps/desktop/src-tauri/pdfium
+          cp target/pdfium/bin/pdfium.dll apps/desktop/src-tauri/pdfium/
+          rm -rf target/pdfium
+      - name: Build installer
+        working-directory: apps/desktop
+        shell: bash
+        env:
+          TAURI_SIGNING_PRIVATE_KEY: ${{ secrets.TAURI_SIGNING_PRIVATE_KEY }}
+          TAURI_SIGNING_PRIVATE_KEY_PASSWORD: ""
+        run: pnpm tauri build --target x86_64-pc-windows-msvc --config src-tauri/pdfium.windows.conf.json
+      - uses: actions/upload-artifact@v4
+        with:
+          name: deckle-windows-installer
+          path: target/x86_64-pc-windows-msvc/release/bundle/nsis/*-setup.exe
+          retention-days: 14
